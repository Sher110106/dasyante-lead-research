{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "dasyante/**",
      "excludeFiles": "{.env,.env.*,.checks/**,.firecrawl/**,tests/**,docs/**,*.db,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
